# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=honest-consultant
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=creditunion
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# Full DSN (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://appuser:changeme@postgres:5432/creditunion

# =============================================================================
# LLM PROVIDER  (adapter pattern — only change PROVIDER + matching key/model)
# =============================================================================
LLM_PROVIDER=openai          # options: openai | anthropic
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Extraction tuning
LLM_CONFIDENCE_THRESHOLD=0.80    # Below this -> HUMAN_REVIEW
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# =============================================================================
# CRM INTEGRATION
# =============================================================================
CRM_PROVIDER=mock             # options: mock | hubspot | zoho
MOCK_CRM_URL=http://mock-crm:9000

HUBSPOT_API_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_PORTAL_URL=https://crm.zoho.com

# =============================================================================
# n8n WORKFLOW ENGINE
# =============================================================================
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_API_KEY=

# =============================================================================
# NOTIFICATIONS
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATIONS_FROM_EMAIL=no-reply@creditunion.example.com

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# =============================================================================
# PIPELINE THRESHOLDS (rules engine knobs)
# =============================================================================
MIN_AGE_YEARS=18
MAX_AGE_YEARS=70
MIN_MONTHLY_INCOME_USD=1500
MAX_LOAN_TO_INCOME_RATIO=5.0     # requested loan <= 5x annual income
ID_EXPIRY_BUFFER_DAYS=30         # ID must not expire within 30 days

# =============================================================================
# AUDIT LOG
# =============================================================================
AUDIT_LOG_LEVEL=INFO
