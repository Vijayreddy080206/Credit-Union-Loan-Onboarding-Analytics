# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=honest-consultant
APP_ENV=development
DEBUG=true
SECRET_KEY=

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=creditunion
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+asyncpg://appuser:changeme@postgres:5432/creditunion

# =============================================================================
# LLM PROVIDER
# Options: mock | groq | openai | anthropic
# =============================================================================
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Extraction tuning
LLM_CONFIDENCE_THRESHOLD=0.80
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# =============================================================================
# CRM INTEGRATION
# Options: mock | hubspot | zoho
# =============================================================================
CRM_PROVIDER=mock
MOCK_CRM_URL=http://mock-crm:9000

HUBSPOT_API_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_PORTAL_URL=

# =============================================================================
# n8n WORKFLOW ENGINE
# =============================================================================
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=

# =============================================================================
# NOTIFICATIONS
# =============================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATIONS_FROM_EMAIL=
SLACK_WEBHOOK_URL=

# =============================================================================
# PIPELINE THRESHOLDS (rules engine knobs)
# =============================================================================
MIN_AGE_YEARS=18
MIN_MONTHLY_INCOME_USD=1500
MAX_LOAN_TO_INCOME_RATIO=5.0
ID_EXPIRY_BUFFER_DAYS=30

# =============================================================================
# AUDIT LOG
# =============================================================================
AUDIT_LOG_LEVEL=INFO
